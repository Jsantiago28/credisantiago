# Cabeceras de seguridad y de caché para Cloudflare Pages.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=()

# Estos archivos no cambian de nombre con cada versión: el navegador debe
# preguntar siempre si hay una nueva.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
/main.dart.js
  Cache-Control: no-cache
