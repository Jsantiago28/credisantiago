# Reglas de direcciones para Cloudflare Pages.
# Cloudflare quita el ".html" solo (/terminos sirve terminos.html), por eso
# los destinos van sin ".html". Lo que no tenga regla ni archivo abre la app
# (index.html), porque no hay 404.html.
/        /presentacion  200
/s/*     /solicitud     200
/i/*     /invitar       200
